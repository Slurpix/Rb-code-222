		description.AutomaticSize = Enum.AutomaticSize.Y
		description.TextYAlignment = Enum.TextYAlignment.Top
	end

	local function refresh()
		local item = items[creationData[key]]
		local text = entryName(item)
		if item.Locked then
			text = text .. " (закрыто)"
		end
		value.Text = text
		value.TextColor3 = item.Locked and C.Dim or C.Text
		if description then
			description.Text = entryDesc(item)
		end
	end

	local function set(newIndex)
		creationData[key] = newIndex
		if creatorWarning then
			creatorWarning.Text = ""
		end
		refresh()
	end

	local function step(delta)
		set(((creationData[key] - 1 + delta) % #items) + 1)
	end

	left.MouseButton1Click:Connect(function() playClick(); step(-1) end)
	right.MouseButton1Click:Connect(function() playClick(); step(1) end)
	value.MouseButton1Click:Connect(function() playClick(); step(1) end)

	choiceRows[key] = {Set = set, Refresh = refresh, Count = #items}
	refresh()
end

