		{Name = "Паладин", Wealth = 4}, {Name = "Архиепископ", Wealth = 5}, {Name = "Мечник на службе", Wealth = 3},
		{Name = "Мечник со своими владениями", Wealth = 5}, {Name = "Бард", Wealth = 2}, {Name = "Фермер", Wealth = 1},
		{Name = "Пекарь", Wealth = 2}, {Name = "Учёный", Wealth = 3}, {Name = "Маг на службе", Wealth = 3},
		{Name = "Маг со своими владениями", Wealth = 5}, {Name = "Лекарь", Wealth = 3}, {Name = "Придворный лекарь", Wealth = 4},
		{Name = "Служанка", Wealth = 1}, {Name = "Дворецкий", Wealth = 3}, {Name = "Ассасин", Wealth = 3},
		{Name = "Призыватель духов, владеющий луком", Wealth = 3}, {Name = "Король", Wealth = 6},
		{Name = "Дворянин", Wealth = 5}, {Name = "Подавальщик", Wealth = 1}, {Name = "Подавальщица", Wealth = 1},
		{Name = "Искатель приключений", Wealth = 2}, {Name = "Бывший искатель приключений", Wealth = 2}
	}
	return p[math.random(1, #p)]
end

local function generateProfessionData()
	if math.random(1, 100) <= 10 then
		return "Безработный", 0
	end
	local p1 = pickRandomProfession()
	local p2 = nil
	if math.random(1, 100) <= 25 then
		p2 = pickRandomProfession()
	end

	if p2 then
		if (p1.Name == "Мелкий разбойник" and p2.Name == "Король") or (p2.Name == "Мелкий разбойник" and p1.Name == "Король") then
			return "Бывший мелкий разбойник, ставший королём", 6
		end
		local maxW = math.max(p1.Wealth, p2.Wealth)
		return p1.Name .. " и " .. p2.Name, maxW
	else
		return p1.Name, p1.Wealth
	end
end

local function rollRandomParts()
	resolved.gender = creationData.gender
	resolved.firstName = pick(FirstNames[resolved.gender])
	resolved.lastPair = pick(LastNames)
	resolved.place = pick(Places)

	local diff = creationData.difficulty
	local orphanChance = 2
	local singleParentChance = 5

	if diff == 2 then orphanChance = 1; singleParentChance = 2
	elseif diff == 3 then orphanChance = 5; singleParentChance = 10
	elseif diff == 4 then orphanChance = 15; singleParentChance = 20
	elseif diff == 5 then orphanChance = 25; singleParentChance = 25
	elseif diff == 6 then orphanChance = 50; singleParentChance = 30
	end

	local roll = math.random(1, 100)
	local fWealth, mWealth = 0, 0

	if roll <= orphanChance then
		resolved.familyStatus = "Сирота"
		resolved.fatherFirstName, resolved.motherFirstName = nil, nil
		resolved.fatherProf, resolved.motherProf = "Неизвестно", "Неизвестно"
		resolved.upbringing = "Воспитывался(ась) в приюте / на улице"
	elseif roll <= orphanChance + singleParentChance then
		if math.random(1, 2) == 1 then
			resolved.familyStatus = "Неполная (только отец)"
			resolved.fatherFirstName = pick(FirstNames["Мужской"])
			resolved.motherFirstName = nil
			resolved.fatherProf, fWealth = generateProfessionData()
			resolved.motherProf = "Неизвестно"
			resolved.upbringing = "Воспитывал отец"
		else
			resolved.familyStatus = "Неполная (только мать)"
			resolved.fatherFirstName = nil
			resolved.motherFirstName = pick(FirstNames["Женский"])
			resolved.fatherProf = "Неизвестно"
			resolved.motherProf, mWealth = generateProfessionData()
			resolved.upbringing = "Воспитывала мать"
		end
	else
		resolved.familyStatus = "Полная семья"
		resolved.fatherFirstName = pick(FirstNames["Мужской"])
		resolved.motherFirstName = pick(FirstNames["Женский"])
		resolved.fatherProf, fWealth = generateProfessionData()
		resolved.motherProf, mWealth = generateProfessionData()
		resolved.upbringing = "Воспитывали оба родителя"
	end

	local avgWealth = 0
	if resolved.fatherFirstName and resolved.motherFirstName then
		avgWealth = math.floor((fWealth + mWealth) / 2)
	elseif resolved.fatherFirstName then
		avgWealth = fWealth
	elseif resolved.motherFirstName then
		avgWealth = mWealth
	else
		avgWealth = 1
	end

	local wealthLabels = {"Нищета", "Бедность", "Средний достаток", "Зажиточность", "Богатство", "Королевская роскошь"}
	resolved.familyWealth = wealthLabels[math.clamp(avgWealth, 1, 6)]
	resolved.isNobleFamily = (avgWealth >= 4) or (math.random(1, 100) <= 10)

	for key, items in pairs(Lists) do
		resolved.indices[key] = pick(openIndices(items))
	end
end

