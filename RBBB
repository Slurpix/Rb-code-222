local currentAge = 0

local function refreshMainMenu()
	if currentCharacter then
		menuSingleDesc.Text = "Продолжить за " .. currentCharacter.FirstName .. " " .. currentCharacter.LastName .. ", возраст " .. currentAge
	else
		menuSingleDesc.Text = "Создай персонажа и проживи свою жизнь."
	end
end

function showScreen(screen)
	titleScreen.Visible = false
	mainMenu.Visible = false
	updateLogFrame.Visible = false
	feedbackFrame.Visible = false
	gameScreen.Visible = false
	deathFrame.Visible = false
	settingsFrame.Visible = false
	creationFrame.Visible = false
	newbornFrame.Visible = false

	screen.Visible = true
	if screen == mainMenu then
		refreshMainMenu()
	end
end

function showDeathScreen(reason)
	showScreen(deathFrame)
	deathReason.Text = reason or "Конец жизни"
end

function updateUI(life)
	if not life then return end
	ageLabel.Text = "ВОЗРАСТ " .. life.Age
	currentAge = life.Age
	goldHeaderLabel.Text = "Золото: " .. life.Gold

	local d = currentCharacter
	if d then
		subLabel.Text = d.Race .. "  ·  " .. d.Gender .. "  ·  Возраст " .. life.Age
	else
		subLabel.Text = "Возраст " .. life.Age
	end

	local function setBar(valueLabel, fill, value, inverted)
		local v = math.clamp(value, 0, 100)
		local ratio = v / 100
		local good = inverted and (1 - ratio) or ratio
		local barColor = GC.Green
		if good < 0.3 then
			barColor = GC.Red
		elseif good < 0.6 then
			barColor = GC.Gold
		end
		valueLabel.Text = tostring(v) .. " / 100"
		valueLabel.TextColor3 = barColor
		TweenService:Create(fill, TweenInfo.new(0.25), {
			Size = UDim2.new(ratio, 0, 1, 0),
			BackgroundColor3 = barColor,
		}):Play()
	end
	setBar(healthValueLabel, healthFill, life.Health, false)
	setBar(happyValueLabel, happyFill, life.Happiness or 50, false)
	setBar(stressValueLabel, stressFill, life.Stress or 0, true)

	charStatLabels.Strength.Text = tostring(life.Strength)
	charStatLabels.Magic.Text = tostring(life.Magic)
	charStatLabels.Gold.Text = tostring(life.Gold)
end

local function updateCharacterInfo()
	local d = currentCharacter
	if not d then
		nameLabel.Text = "Персонаж"
		subLabel.Text = ""
		difficultyLabel.Text = ""
		charInfoLabel.Text = "Персонаж ещё не создан."
		return
	end
	local displaySurname = (d.LastName ~= "") and (" " .. d.LastName) or ""
	nameLabel.Text = d.FirstName .. displaySurname
	difficultyLabel.Text = "Сложность: " .. d.Difficulty

	charInfoLabel.Text = string.format(
		"Раса: %s\nПол: %s\nСценарий: %s\n\n" ..
			"Внешность:\n• %s волосы\n• %s глаза\n• %s кожа\n• %s рост\n\n" ..
			"Место рождения: %s\nСемья: %s\nОтец: %s\nМать: %s\nБогатство семьи: %s",
		d.Race, d.Gender, d.Scenario,
		d.Hair, d.Eyes, d.Skin, d.Height,
		d.PlaceName, d.FamilyStatus, d.FatherName, d.MotherName, d.FamilyWealth
	)
end

beginLifeButton.MouseButton1Click:Connect(function()
	playClick()
	local ok, life = pcall(function()
		return GetLife:InvokeServer()
	end)
	if ok and life then
		currentCharacter = currentPreview
		updateCharacterInfo()
		updateUI(life)
		selectTab("Жизнь")
		showScreen(gameScreen)
		fitGameScreen()
	else
		beginLifeButton.Text = "ОШИБКА ЗАГРУЗКИ ЖИЗНИ"
		task.delay(2.5, function()
			beginLifeButton.Text = "НАЧАТЬ ЖИЗНЬ"
		end)
	end
end)

local transitioning = false

local function showTitleScreen()
	transitioning = false
	titleGroup.GroupTransparency = 0
	showScreen(titleScreen)
end

local function transitionToMenu()
	if transitioning then return end
	transitioning = true
	playClick()
	local fade = TweenService:Create(titleGroup, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		GroupTransparency = 1
	})
	fade:Play()
	fade.Completed:Wait()
	menuPanel.GroupTransparency = 1
	showScreen(mainMenu)
	TweenService:Create(menuPanel, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		GroupTransparency = 0
	}):Play()
end

startButton.MouseButton1Click:Connect(transitionToMenu)

