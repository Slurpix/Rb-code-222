local function bindFit(root, scaleObj, w, h, maxScale)
	local function update()
		local size = screenGui.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then return end
		local userScale = uiScale.Scale
		local total = math.clamp(math.min(size.X / (w + 40), (size.Y - 64) / (h + 20)), 0.4, maxScale)
		scaleObj.Scale = total
		root.Position = UDim2.new(0.5, 0, 0, (64 + (size.Y - 64) / 2) / userScale)
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	uiScale:GetPropertyChangedSignal("Scale"):Connect(update)
	update()
end

local function addCorners(panel, w, h)
	local function line(x, y, lw, lh)
		local f = Instance.new("Frame")
		f.Position = UDim2.new(0, x, 0, y)
		f.Size = UDim2.new(0, lw, 0, lh)
		f.BackgroundColor3 = MC.Gold
		f.BorderSizePixel = 0
		f.ZIndex = 3
		f.Parent = panel
	end
	local function diamond(x, y)
		local f = Instance.new("Frame")
		f.Position = UDim2.new(0, x, 0, y)
		f.Size = UDim2.new(0, 8, 0, 8)
		f.BackgroundColor3 = MC.Gold
		f.BorderSizePixel = 0
		f.Rotation = 45
		f.ZIndex = 3
		f.Parent = panel
	end
	local inset, len, thick = 8, 32, 2
	for _, sx in ipairs({0, 1}) do
		for _, sy in ipairs({0, 1}) do
			line(sx == 0 and inset or (w - inset - len), sy == 0 and inset or (h - inset - thick), len, thick)
			line(sx == 0 and inset or (w - inset - thick), sy == 0 and inset or (h - inset - len), thick, len)
			diamond(sx == 0 and 14 or (w - 22), sy == 0 and 14 or (h - 22))
		end
	end
end

local function createHotButton(parent, x, y, w, h, startPrimary)
	local btn = Instance.new("TextButton")
	btn.Position = UDim2.new(0, x, 0, y)
	btn.Size = UDim2.new(0, w, 0, h)
	btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	local base = Instance.new("UIGradient")
	base.Rotation = 90
	base.Color = ColorSequence.new(MC.DarkTop, MC.DarkBottom)
	base.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Color = MC.DarkStroke
	stroke.Parent = btn

	local hot = Instance.new("Frame")
	hot.Size = UDim2.new(1, 0, 1, 0)
	hot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	hot.BackgroundTransparency = 1
	hot.BorderSizePixel = 0
	hot.ZIndex = 1
	hot.Parent = btn
	local hotCorner = Instance.new("UICorner")
	hotCorner.CornerRadius = UDim.new(0, 8)
	hotCorner.Parent = hot
	local hotGradient = Instance.new("UIGradient")
	hotGradient.Rotation = 90
	hotGradient.Color = ColorSequence.new(MC.HotTop, MC.HotBottom)
	hotGradient.Parent = hot

	local pressScale = Instance.new("UIScale")
	pressScale.Parent = btn

	local state = {primary = startPrimary == true, hover = false}
	local function apply()
		local active = state.primary or state.hover
		TweenService:Create(hot, TweenInfo.new(0.15), {BackgroundTransparency = active and 0 or 1}):Play()
		TweenService:Create(stroke, TweenInfo.new(0.15), {Color = active and MC.HotStroke or MC.DarkStroke}):Play()
	end

	btn.MouseEnter:Connect(function()
		state.hover = true
		apply()
	end)
	btn.MouseLeave:Connect(function()
		state.hover = false
		apply()
		TweenService:Create(pressScale, TweenInfo.new(0.1), {Scale = 1}):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(pressScale, TweenInfo.new(0.08), {Scale = 0.985}):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(pressScale, TweenInfo.new(0.1), {Scale = 1}):Play()
	end)
	apply()

	return btn, function(primary)
		state.primary = primary
		apply()
	end
end

