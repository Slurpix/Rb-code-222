local function ruLower(s)
	local out = {}
	for _, cp in utf8.codes(s) do
		local c = cp
		if c >= 0x410 and c <= 0x42F then
			c += 32
		elseif c == 0x401 then
			c = 0x451
		end
		table.insert(out, utf8.char(c))
	end
	return table.concat(out)
end

local function trim(s)
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function pick(list)
