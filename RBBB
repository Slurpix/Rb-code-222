local function randomizeChoices()
	setGender(pick({"Мужской", "Женский"}))
	for key, items in pairs(Lists) do
		choiceRows[key].Set(pick(openIndices(items)))
	end
end

local function generateFullyRandom()
	randomizeChoices()
	firstNameInput.Text = ""
	lastNameInput.Text = ""
	creatorWarning.Text = ""
	rollRandomParts()
	rerollsRemaining = 0
	rerollAllowed = false
	updateRerollButton()
