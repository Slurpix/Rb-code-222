local function getCreationResult()
	local first = trim(firstNameInput.Text)
	if first == "" then
		first = resolved.firstName
	end
	local gender = resolved.gender

	local userSurname = trim(lastNameInput.Text)
	local fatherSurname = ""
	local motherSurname = ""
	local childSurname = ""

	if userSurname ~= "" then
		fatherSurname = " " .. userSurname
		motherSurname = " " .. userSurname
		childSurname = userSurname
	else
		if resolved.isNobleFamily then
			local randomNoble = resolved.lastPair
			fatherSurname = " " .. randomNoble
			motherSurname = " " .. randomNoble
			childSurname = randomNoble
		else
			childSurname = resolved.lastPair
		end
	end

	local fName = ""
	local mName = ""

	if resolved.fatherFirstName then
		fName = resolved.fatherFirstName .. fatherSurname .. " (" .. resolved.fatherProf .. ")"
	else
		fName = "Неизвестен / Погиб"
	end

	if resolved.motherFirstName then
		mName = resolved.motherFirstName .. motherSurname .. " (" .. resolved.motherProf .. ")"
	else
		mName = "Неизвестна / Погибла"
	end

	local idx = {}
	for key, items in pairs(Lists) do
		if items[creationData[key]].Random then
			idx[key] = resolved.indices[key]
		else
			idx[key] = creationData[key]
		end
	end
	local race = Races[idx.race]
	local scenario = Scenarios[idx.scenario]

	return {
		FirstName = first,
		LastName = childSurname,
		Gender = gender,
		Race = race.Name,
		RaceDesc = race.Desc or "",
		Scenario = entryName(scenario, gender),
		ScenarioDesc = entryDesc(scenario, gender),
		Difficulty = Difficulties[idx.difficulty].Name,
		Hair = ruLower(Hair[idx.hair].Name),
		Eyes = ruLower(Eyes[idx.eyes].Name),
		Skin = ruLower(Skin[idx.skin].Name),
		Height = ruLower(Height[idx.height].Name),
		PlaceName = resolved.place.Name,
		PlaceDesc = resolved.place.Desc,
		FamilyStatus = resolved.familyStatus,
		FatherName = fName,
		MotherName = mName,
		Upbringing = resolved.upbringing,
		FamilyWealth = resolved.familyWealth,
	}
end

