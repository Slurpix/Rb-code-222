local function updateRerollButton()
	rerollLifeButton.Visible = rerollAllowed
	if rerollsRemaining > 0 then
		rerollLifeButton.Text = "Перебросить жизнь (1 попытка)"
		rerollLifeButton.TextTransparency = 0
	else
		rerollLifeButton.Text = "Попытка использована"
		rerollLifeButton.TextTransparency = 0.5
	end
end

local function refreshNewborn()
	local d = getCreationResult()
	currentPreview = d
	newbornTitle.Text = (d.Gender == "Женский") and "НОВОРОЖДЁННАЯ" or "НОВОРОЖДЁННЫЙ"
	local raceLine = "Раса: " .. d.Race
	if d.RaceDesc ~= "" then raceLine = raceLine .. "\n" .. d.RaceDesc end
	local scenarioLine = "Сценарий: " .. d.Scenario
	if d.ScenarioDesc ~= "" then scenarioLine = scenarioLine .. "\n" .. d.ScenarioDesc end

	local displaySurname = (d.LastName ~= "") and (" " .. d.LastName) or ""

	newbornInfo.Text = string.format(
		"Имя: %s%s\n%s\nПол: %s\n\n" ..
			"Место рождения: %s\nОписание места: %s\n\n" ..
			"Семья (%s):\nОтец: %s\nМать: %s\n\n" ..
			"Воспитание: %s\n\n" ..
			"Богатство семьи: %s\nЗдоровье: Не задано\nПотенциал Боевой Ауры: Не задано\n\n" ..
			"Внешность: %s волосы, %s глаза, %s кожа, %s рост\n\n" ..
			"Стихийная предрасположенность: Не задано\nОбщая черта: Не задано\n\n" ..
			"НЕИЗВЕСТНЫЕ ТАЛАНТЫ\nНе задано\nНе задано\nНе задано\n\n" ..
			"ХАРАКТЕРИСТИКИ\nСила: Не задано     Ловкость: Не задано\n" ..
			"Интеллект: Не задано     Живучесть: Не задано\n" ..
			"Мана: Не задано     Удача: Не задано\nХаризма: Не задано\n\n" ..
			"%s\nСложность: %s\n\n" ..
			"Наследие — валюта, получаемая после смерти персонажа или перехода в тело наследника.",
		d.FirstName, displaySurname, raceLine, d.Gender,
		d.PlaceName, d.PlaceDesc,
		d.FamilyStatus, d.FatherName, d.MotherName,
		d.Upbringing, d.FamilyWealth,
		d.Hair, d.Eyes, d.Skin, d.Height,
		scenarioLine, d.Difficulty
	)
end

