	local function applyRow(name, hovered)
		local row = sideRows[name]
		if not row then return end
		local selected = (name == selectedTab)
		if selected then
			row.grad.Color = ROW_SELECTED
			row.stroke.Color = Color3.fromRGB(255, 181, 48)
			row.stroke.Thickness = 2
			row.text.TextColor3 = Color3.fromRGB(255, 244, 220)
		elseif hovered then
			row.grad.Color = ROW_HOVER
			row.stroke.Color = Color3.fromRGB(205, 135, 50)
			row.stroke.Thickness = 1.5
			row.text.TextColor3 = GC.Text
		else
			row.grad.Color = ROW_NORMAL
			row.stroke.Color = Color3.fromRGB(105, 58, 20)
			row.stroke.Thickness = 1
			row.text.TextColor3 = GC.Text
		end
		row.bar.Visible = selected
	end

