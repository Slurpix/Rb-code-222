local function drawIcon(parent, kind, color, bg, z)
	local box = Instance.new("Frame")
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.ZIndex = z
	box.Parent = parent

	local function part(x, y, w, h, col, round, rot)
		local f = Instance.new("Frame")
		f.Position = UDim2.new(x, 0, y, 0)
		f.Size = UDim2.new(w, 0, h, 0)
		f.BackgroundColor3 = col
		f.BorderSizePixel = 0
		f.ZIndex = z
		f.Rotation = rot or 0
		f.Parent = box
		if round and round > 0 then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(round, 0)
			c.Parent = f
		end
		return f
	end

	local function person(ox, oy, k)
		part(ox + 0.33 * k, oy + 0.06 * k, 0.34 * k, 0.34 * k, color, 0.5)
		part(ox + 0.15 * k, oy + 0.46 * k, 0.70 * k, 0.46 * k, color, 0.45)
	end

	if kind == "person" then
		person(0, 0, 1)
	elseif kind == "people" then
		person(0.30, 0.02, 0.7)
		person(-0.05, 0.22, 0.85)
	elseif kind == "scroll" then
		part(0.2, 0.1, 0.6, 0.8, color, 0.12)
		part(0.32, 0.26, 0.36, 0.07, bg, 0.5)
		part(0.32, 0.44, 0.36, 0.07, bg, 0.5)
		part(0.32, 0.62, 0.24, 0.07, bg, 0.5)
	elseif kind == "bubble" then
		part(0.08, 0.12, 0.84, 0.58, color, 0.25)
		part(0.2, 0.56, 0.22, 0.22, color, 0, 45)
		part(0.24, 0.36, 0.1, 0.1, bg, 0.5)
		part(0.45, 0.36, 0.1, 0.1, bg, 0.5)
		part(0.66, 0.36, 0.1, 0.1, bg, 0.5)
	elseif kind == "heart" then
		part(0.1, 0.14, 0.42, 0.42, color, 0.5)
		part(0.48, 0.14, 0.42, 0.42, color, 0.5)
		part(0.24, 0.28, 0.52, 0.52, color, 0.08, 45)
	elseif kind == "star" then
		part(0.2, 0.2, 0.6, 0.6, color, 0.05)
		part(0.2, 0.2, 0.6, 0.6, color, 0.05, 45)
		part(0.42, 0.42, 0.16, 0.16, bg, 0.5)
	elseif kind == "pin" then
		part(0.26, 0.06, 0.48, 0.48, color, 0.5)
		part(0.32, 0.38, 0.36, 0.36, color, 0.06, 45)
		part(0.4, 0.2, 0.2, 0.2, bg, 0.5)
	elseif kind == "cup" then
		part(0.24, 0.1, 0.52, 0.5, color, 0.3)
		part(0.06, 0.16, 0.18, 0.26, color, 0.5)
		part(0.76, 0.16, 0.18, 0.26, color, 0.5)
		part(0.43, 0.56, 0.14, 0.2, color)
		part(0.28, 0.76, 0.44, 0.14, color, 0.3)
	elseif kind == "gear" then
		part(0.42, 0.04, 0.16, 0.92, color, 0.2, 0)
		part(0.42, 0.04, 0.16, 0.92, color, 0.2, 45)
		part(0.42, 0.04, 0.16, 0.92, color, 0.2, 90)
		part(0.42, 0.04, 0.16, 0.92, color, 0.2, 135)
		part(0.2, 0.2, 0.6, 0.6, color, 0.5)
		part(0.38, 0.38, 0.24, 0.24, bg, 0.5)
	elseif kind == "disk" then
		part(0.14, 0.14, 0.72, 0.72, color, 0.1)
		part(0.3, 0.14, 0.4, 0.26, bg, 0.1)
		part(0.28, 0.56, 0.44, 0.3, bg, 0.1)
	elseif kind == "door" then
		part(0.24, 0.08, 0.52, 0.84, color, 0.1)
