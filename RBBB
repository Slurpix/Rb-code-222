local function creatorButton(parent, text, size, primary)
	local button = Instance.new("TextButton")
	button.Size = size
	button.BorderSizePixel = 0
	button.Text = text
	button.TextColor3 = C.Text
	button.TextSize = 19
	button.Font = MEDIEVAL_FONT_RU
	button.AutoButtonColor = false
	button.Parent = parent
	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)
	local stroke = Instance.new("UIStroke", button)
	stroke.Thickness = 1

	local hovered, pressed = false, false

	local function applyState()
		local selected = button:GetAttribute("Selected") == true
		local bg, strokeColor, thickness
		if pressed then
			bg, strokeColor, thickness = C.BtnPressed, C.Gold, 2
		elseif selected then
			bg, strokeColor, thickness = C.BtnSelected, C.Gold, 2
		elseif hovered then
			bg, strokeColor, thickness = C.BtnHover, C.StrokeHover, 1.5
		else
			bg = primary and C.BtnPrimary or C.Btn
			strokeColor, thickness = C.StrokeIdle, 1
		end
		TweenService:Create(button, TweenInfo.new(0.12), {BackgroundColor3 = bg}):Play()
		stroke.Color = strokeColor
		stroke.Thickness = thickness
	end

	button.MouseEnter:Connect(function() hovered = true; applyState() end)
	button.MouseLeave:Connect(function() hovered = false; pressed = false; applyState() end)
	button.MouseButton1Down:Connect(function() pressed = true; applyState() end)
	button.MouseButton1Up:Connect(function() pressed = false; applyState() end)
	button:GetAttributeChangedSignal("Selected"):Connect(applyState)
	applyState()

	return button
end

